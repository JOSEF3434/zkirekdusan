generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

/// Global platform roles — only 3 at platform level
enum GlobalRole {
  SUPER_ADMIN
  ADMIN
  USER
}

/// Group-scoped roles — granular control inside a group
enum GroupRole {
  GROUP_ADMIN
  MODERATOR
  MEMBER
  GUEST
}

/// Group lifecycle — new groups require admin approval
enum GroupStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum GroupVisibility {
  PUBLIC
  PRIVATE
  INVITE_ONLY
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BANNED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum ProfileVisibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

enum FileProvider {
  LOCAL
  S3
  CLOUDINARY
  MINIO
}

enum FileType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  ARCHIVE
  OTHER
}

enum FileStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
  DELETED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

// ─────────────────────────────────────────────
// Phase 2 Enums
// ─────────────────────────────────────────────

enum PostType {
  TEXT
  IMAGE
  VIDEO
  CAROUSEL
}

enum PostVisibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
  GROUP_ONLY
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  DELETED
}

enum StoryType {
  IMAGE
  VIDEO
  TEXT
}

enum ReactionType {
  LIKE
  LOVE
  HAHA
  WOW
  SAD
  ANGRY
}

// ─────────────────────────────────────────────
// Phase 3 Messaging Enums
// ─────────────────────────────────────────────

enum ChannelType {
  TEXT
  ANNOUNCEMENT
  VOICE
}

enum ConversationType {
  DIRECT
  GROUP_CHANNEL
  GROUP_DIRECT
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  VOICE_NOTE
  ANNOUNCEMENT
  SYSTEM
}

enum PresenceStatus {
  ONLINE
  IDLE
  BUSY
  OFFLINE
}

enum NotificationType {
  MESSAGE
  MENTION
  REACTION
  GROUP_INVITE
  GROUP_JOIN_REQUEST
  GROUP_APPROVE
  SYSTEM
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────────
// ROLE & PERMISSIONS (global)
// ─────────────────────────────────────────────

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)

  users       User[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id String @id @default(uuid())

  email       String?  @unique
  phoneNumber String?  @unique
  username    String   @unique

  passwordHash String

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  status UserStatus @default(ACTIVE)

  isEmailVerified Boolean @default(false)
  isPhoneVerified Boolean @default(false)

  lastLoginAt DateTime?

  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?

  profile Profile?

  sessions      Session[]
  refreshTokens RefreshToken[]

  uploadedFiles File[]

  groupMemberships GroupMember[]
  sentInvites      GroupInvite[] @relation("InviteSender")
  receivedInvites  GroupInvite[] @relation("InviteRecipient")

  createdGroups   Group[] @relation("GroupCreator")
  approvedGroups  Group[] @relation("GroupApprover")

  // Social features
  following Follow[] @relation("UserFollowing")
  followers Follow[] @relation("UserFollowers")

  posts    Post[]
  stories  Story[]
  reels    Reel[]

  postLikes    PostLike[]
  reelLikes    ReelLike[]
  commentLikes CommentLike[]

  comments      Comment[]
  reelComments  ReelComment[]

  savedPosts SavedPost[]
  storyViews StoryView[]

  // Phase 3 Messaging Relations
  conversationMembers ConversationMember[]
  messages            Message[]
  messageReactions    MessageReaction[]
  messageReads        MessageRead[]
  messageDeliveries   MessageDelivery[]
  pinnedMessages      PinnedMessage[]
  starredMessages     StarredMessage[]
  groupJoinRequests   GroupJoinRequest[]
  presence            UserPresence?
  notifications       Notification[]
  auditLogs           AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([phoneNumber])
  @@index([username])
  @@index([roleId])
  @@map("users")
}

// ─────────────────────────────────────────────
// PROFILE
// ─────────────────────────────────────────────

model Profile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName   String?
  lastName    String?
  displayName String?
  bio         String?  @db.Text
  website     String?
  country     String?
  language    String?
  gender      Gender?
  birthDate   DateTime?

  visibility ProfileVisibility @default(PUBLIC)

  isVerified        Boolean  @default(false)
  verifiedAt        DateTime?
  verificationBadge String?

  avatarFileId String?
  coverFileId  String?

  avatar File? @relation("ProfileAvatar", fields: [avatarFileId], references: [id])
  cover  File? @relation("ProfileCover", fields: [coverFileId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("profiles")
}

// ─────────────────────────────────────────────
// GROUP
// ─────────────────────────────────────────────

model Group {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String? @db.Text
  avatarUrl   String?
  coverUrl    String?
  website     String?
  country     String?

  status     GroupStatus     @default(PENDING_APPROVAL)
  visibility GroupVisibility @default(PUBLIC)

  /// The user who created the group
  createdById String
  createdBy   User   @relation("GroupCreator", fields: [createdById], references: [id])

  /// Admin who approved or rejected the group (ADMIN/SUPER_ADMIN)
  approvedById String?
  approvedBy   User?   @relation("GroupApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  members GroupMember[]
  invites GroupInvite[]
  files   File[]
  posts   Post[]

  // Phase 3 Messaging Relations
  channels      Channel[]
  conversations Conversation[]
  joinRequests  GroupJoinRequest[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([slug])
  @@index([status])
  @@index([createdById])
  @@map("groups")
}

model GroupMember {
  id      String    @id @default(uuid())
  groupId String
  userId  String

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  role GroupRole @default(MEMBER)

  joinedAt  DateTime  @default(now())
  removedAt DateTime?

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@map("group_members")
}

model GroupInvite {
  id      String @id @default(uuid())
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  senderId    String
  sender      User   @relation("InviteSender", fields: [senderId], references: [id])

  recipientId String
  recipient   User   @relation("InviteRecipient", fields: [recipientId], references: [id])

  role   GroupRole  @default(MEMBER)
  status InviteStatus @default(PENDING)
  token  String     @unique @default(uuid())

  expiresAt   DateTime
  respondedAt DateTime?

  createdAt DateTime @default(now())

  @@index([groupId])
  @@index([recipientId])
  @@index([token])
  @@map("group_invites")
}

// ─────────────────────────────────────────────
// SESSION
// ─────────────────────────────────────────────

model Session {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ipAddress String?
  userAgent String?
  device    String?
  browser   String?
  os        String?
  location  String?

  status    SessionStatus @default(ACTIVE)
  expiresAt DateTime
  lastSeenAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

// ─────────────────────────────────────────────
// REFRESH TOKEN
// ─────────────────────────────────────────────

model RefreshToken {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String

  expiresAt DateTime
  revokedAt DateTime?

  createdByIp String?
  userAgent   String?
  device      String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────
// FILE
// ─────────────────────────────────────────────

model File {
  id String @id @default(uuid())

  /// Original filename from the client
  originalName String

  /// Stored filename (UUID-based, safe for filesystem)
  fileName String

  mimeType  String
  extension String
  size      BigInt

  fileType FileType @default(OTHER)

  /// Storage backend used for this file
  provider  FileProvider
  /// Provider-specific key/path (e.g. "uploads/2024/01/file.jpg" for local, Cloudinary public_id, etc.)
  storageKey String
  /// Public-facing URL
  url        String

  /// SHA-256 checksum of the file contents
  checksum String?

  status FileStatus @default(READY)

  /// Width in pixels (images/video)
  width  Int?
  /// Height in pixels (images/video)
  height Int?
  /// Duration in seconds (video/audio)
  duration Float?

  /// Thumbnail URL (for video/image, generated by provider)
  thumbnailUrl String?

  /// Additional metadata as JSON (e.g. EXIF, codec info)
  metadata Json?

  /// The user who uploaded the file
  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  /// Every file MUST belong to a group (group-scoped uploads only)
  groupId String
  group   Group  @relation(fields: [groupId], references: [id])

  /// Profiles using this file as avatar
  avatarOf Profile[] @relation("ProfileAvatar")
  /// Profiles using this file as cover
  coverOf  Profile[] @relation("ProfileCover")

  /// Post media references
  postMedia PostMedia[]

  /// Reel file references
  reels Reel[]

  /// Story file references
  stories Story[]

  /// Phase 3 Message attachment references
  messageAttachments MessageAttachment[]
  voiceMessages      VoiceMessage[]

  /// Soft delete
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([uploadedById])
  @@index([groupId])
  @@index([fileType])
  @@index([status])
  @@index([deletedAt])
  @@map("files")
}

// ─────────────────────────────────────────────
// FOLLOW
// ─────────────────────────────────────────────

model Follow {
  followerId  String
  followingId String

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

// ─────────────────────────────────────────────
// POST
// ─────────────────────────────────────────────

model Post {
  id       String @id @default(uuid())
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  type       PostType
  status     PostStatus     @default(PUBLISHED)
  visibility PostVisibility @default(PUBLIC)

  content  String? @db.Text
  hashtags String[]
  mentions String[] // array of user IDs mentioned

  /// Denormalized counters for feed performance
  likesCount    Int @default(0)
  commentsCount Int @default(0)
  sharesCount   Int @default(0)
  viewsCount    Int @default(0)

  media    PostMedia[]
  likes    PostLike[]
  comments Comment[]
  savedBy  SavedPost[]

  publishedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([authorId])
  @@index([groupId])
  @@index([status, visibility])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("posts")
}

model PostMedia {
  id      String @id @default(uuid())
  postId  String
  fileId  String
  order   Int    @default(0)
  caption String?
  altText String?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  file File @relation(fields: [fileId], references: [id])

  @@index([postId])
  @@map("post_media")
}

// ─────────────────────────────────────────────
// LIKES
// ─────────────────────────────────────────────

model PostLike {
  userId   String
  postId   String
  reaction ReactionType @default(LIKE)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, postId])
  @@index([postId])
  @@map("post_likes")
}

model ReelLike {
  userId   String
  reelId   String
  reaction ReactionType @default(LIKE)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, reelId])
  @@index([reelId])
  @@map("reel_likes")
}

model CommentLike {
  userId    String
  commentId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, commentId])
  @@index([commentId])
  @@map("comment_likes")
}

// ─────────────────────────────────────────────
// COMMENTS
// ─────────────────────────────────────────────

model Comment {
  id       String @id @default(uuid())
  postId   String
  authorId String

  /// null = root-level comment; non-null = reply to another comment
  parentId String?

  content    String @db.Text
  likesCount Int    @default(0)

  post   Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent Comment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")
  likes  CommentLike[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([postId])
  @@index([parentId])
  @@index([authorId])
  @@index([deletedAt])
  @@map("comments")
}

model ReelComment {
  id       String @id @default(uuid())
  reelId   String
  authorId String
  parentId String?
  content  String @db.Text
  likesCount Int  @default(0)

  reel   Reel        @relation(fields: [reelId], references: [id], onDelete: Cascade)
  author User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent ReelComment? @relation("ReelCommentReplies", fields: [parentId], references: [id])
  replies ReelComment[] @relation("ReelCommentReplies")

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([reelId])
  @@index([authorId])
  @@map("reel_comments")
}

// ─────────────────────────────────────────────
// STORIES
// ─────────────────────────────────────────────

model Story {
  id       String @id @default(uuid())
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  type StoryType

  fileId String?
  file   File?   @relation(fields: [fileId], references: [id])

  content         String? @db.Text
  backgroundColor String?
  textColor       String?

  viewsCount Int @default(0)

  expiresAt DateTime // set to createdAt + 24h at creation

  views     StoryView[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([authorId])
  @@index([expiresAt])
  @@index([deletedAt])
  @@map("stories")
}

model StoryView {
  storyId  String
  viewerId String

  story  Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer User  @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  viewedAt DateTime @default(now())

  @@id([storyId, viewerId])
  @@index([storyId])
  @@map("story_views")
}

// ─────────────────────────────────────────────
// REELS
// ─────────────────────────────────────────────

model Reel {
  id       String @id @default(uuid())
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  fileId String
  file   File   @relation(fields: [fileId], references: [id])

  thumbnailUrl String?
  caption      String? @db.Text
  hashtags     String[]
  mentions     String[]

  duration Float // in seconds

  likesCount    Int @default(0)
  commentsCount Int @default(0)
  viewsCount    Int @default(0)
  sharesCount   Int @default(0)

  visibility PostVisibility @default(PUBLIC)
  status     PostStatus     @default(PUBLISHED)

  likes    ReelLike[]
  comments ReelComment[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([authorId])
  @@index([status, visibility])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("reels")
}

// ─────────────────────────────────────────────
// SAVED POSTS
// ─────────────────────────────────────────────

model SavedPost {
  userId  String
  postId  String
  savedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([userId])
  @@map("saved_posts")
}

// ─────────────────────────────────────────────
// PHASE 3 MESSAGING MODELS
// ─────────────────────────────────────────────

model Channel {
  id          String      @id @default(uuid())
  groupId     String
  group       Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  type        ChannelType @default(TEXT)
  description String?     @db.Text
  isPrivate   Boolean     @default(false)

  conversations Conversation[]
  messages      Message[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([groupId, slug])
  @@index([groupId])
  @@map("channels")
}

model Conversation {
  id   String           @id @default(uuid())
  type ConversationType @default(DIRECT)

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  channelId String?  @unique
  channel   Channel? @relation(fields: [channelId], references: [id], onDelete: Cascade)

  lastMessageId String?
  lastMessageAt DateTime?

  members        ConversationMember[]
  messages       Message[]
  pinnedMessages PinnedMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
  @@index([type])
  @@map("conversations")
}

model ConversationMember {
  id             String       @id @default(uuid())
  conversationId String
  userId         String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastReadMessageId String?
  unreadCount       Int     @default(0)
  isMuted           Boolean @default(false)
  isPinned          Boolean @default(false)

  encryptionKeyHash String? // E2EE key exchange metadata ready

  joinedAt DateTime @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
  @@map("conversation_members")
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  channelId      String?
  senderId       String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  channel      Channel?     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  content String?     @db.Text
  type    MessageType @default(TEXT)

  /// Threaded reply parent message
  replyToId String?
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")

  isEdited             Boolean   @default(false)
  isPinned             Boolean   @default(false)
  deletedForEveryoneAt DateTime?

  attachments MessageAttachment[]
  reactions   MessageReaction[]
  reads       MessageRead[]
  deliveries  MessageDelivery[]
  starredBy   StarredMessage[]
  pinnedIn    PinnedMessage[]
  voiceNote   VoiceMessage?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId])
  @@index([channelId])
  @@index([senderId])
  @@index([createdAt])
  @@map("messages")
}

model MessageAttachment {
  id        String @id @default(uuid())
  messageId String
  fileId    String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file    File    @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([fileId])
  @@map("message_attachments")
}

model MessageReaction {
  id        String @id @default(uuid())
  messageId String
  userId    String
  emoji     String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

model MessageRead {
  messageId String
  userId    String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  readAt DateTime @default(now())

  @@id([messageId, userId])
  @@index([messageId])
  @@map("message_reads")
}

model MessageDelivery {
  messageId String
  userId    String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  deliveredAt DateTime @default(now())

  @@id([messageId, userId])
  @@index([messageId])
  @@map("message_deliveries")
}

model PinnedMessage {
  id             String @id @default(uuid())
  conversationId String
  messageId      String
  pinnedById     String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedBy     User         @relation(fields: [pinnedById], references: [id])

  createdAt DateTime @default(now())

  @@unique([conversationId, messageId])
  @@index([conversationId])
  @@map("pinned_messages")
}

model StarredMessage {
  userId    String
  messageId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  starredAt DateTime @default(now())

  @@id([userId, messageId])
  @@index([userId])
  @@map("starred_messages")
}

model VoiceMessage {
  id        String @id @default(uuid())
  messageId String @unique
  fileId    String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file    File    @relation(fields: [fileId], references: [id], onDelete: Cascade)

  duration Int     // duration in seconds
  waveform Json?   // waveform JSON array

  @@map("voice_messages")
}

model GroupJoinRequest {
  id      String            @id @default(uuid())
  groupId String
  userId  String
  status  JoinRequestStatus @default(PENDING)
  note    String?

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@index([groupId])
  @@index([userId])
  @@map("group_join_requests")
}

model UserPresence {
  id           String         @id @default(uuid())
  userId       String         @unique
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       PresenceStatus @default(OFFLINE)
  customStatus String?
  lastSeenAt   DateTime       @default(now())

  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("user_presence")
}

model Notification {
  id     String           @id @default(uuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType
  title  String
  body   String           @db.Text
  data   Json?
  isRead Boolean          @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  resource  String
  details   Json?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}