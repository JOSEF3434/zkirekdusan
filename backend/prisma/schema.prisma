generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

/// Login policy type — which combination of identifiers is required
enum LoginPolicyType {
  SINGLE_IDENTIFIER   /// One of: email | phone | username + password
  DUAL_IDENTIFIER     /// Two of: email+phone | email+username | phone+username + password
  ALL_IDENTIFIERS     /// All three: email + phone + username + password
}

/// Which dual-identifier combination is required (used when policy = DUAL_IDENTIFIER)
enum DualIdentifierCombination {
  EMAIL_PHONE
  EMAIL_USERNAME
  PHONE_USERNAME
}

/// Global platform roles — 5 tiers at platform level
enum GlobalRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  SUPPORT
  USER
}

/// Group-scoped roles — granular control inside a group
enum GroupRole {
  GROUP_ADMIN
  MODERATOR
  MEMBER
  GUEST
}

/// Group lifecycle — new groups require admin approval
enum GroupStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  ARCHIVED
  REJECTED
}

enum GroupVisibility {
  PUBLIC
  PRIVATE
  INVITE_ONLY
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BANNED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum ProfileVisibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
}

enum FileProvider {
  LOCAL
  S3
  CLOUDINARY
  MINIO
}

enum FileType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  ARCHIVE
  OTHER
}

enum FileStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
  DELETED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

// ─────────────────────────────────────────────
// Phase 2 Enums
// ─────────────────────────────────────────────

enum PostType {
  TEXT
  IMAGE
  VIDEO
  CAROUSEL
}

enum PostVisibility {
  PUBLIC
  FOLLOWERS
  PRIVATE
  GROUP_ONLY
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  DELETED
}

enum StoryType {
  IMAGE
  VIDEO
  TEXT
}

enum ReactionType {
  LIKE
  LOVE
  HAHA
  WOW
  SAD
  ANGRY
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE_SPEECH
  MISINFORMATION
  INAPPROPRIATE_CONTENT
  VIOLENCE
  COPYRIGHT
  IMPERSONATION
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ReportTargetType {
  USER
  GROUP
  POST
  COMMENT
  VIDEO
  MESSAGE
}

// ─────────────────────────────────────────────
// Phase 3 Messaging Enums
// ─────────────────────────────────────────────

enum ChannelType {
  TEXT
  ANNOUNCEMENT
  VOICE
}

enum ConversationType {
  DIRECT
  GROUP_CHANNEL
  GROUP_DIRECT
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  VOICE_NOTE
  ANNOUNCEMENT
  SYSTEM
}

enum PresenceStatus {
  ONLINE
  IDLE
  BUSY
  OFFLINE
}

enum NotificationType {
  MESSAGE
  MENTION
  REACTION
  GROUP_INVITE
  GROUP_JOIN_REQUEST
  GROUP_APPROVE
  SYSTEM
  CHANNEL_STATUS
  CHANNEL_NEW_VIDEO
  CHANNEL_NEW_POST
  CHANNEL_LIVE
}

enum CalendarReminderRepeat {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum CalendarPublicationStatus {
  PENDING
  SCHEDULED
  PUBLISHED
  FAILED
  CANCELLED
}

enum CalendarEventType {
  FAST
  HOLIDAY
  SPECIAL_EVENT
}

enum CalendarEventCategory {
  MAJOR_FAST
  MINOR_FAST
  MAJOR_HOLIDAY
  MINOR_HOLIDAY
  MONTHLY_FEAST
  ANNUAL_FEAST
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────────
// ROLE & PERMISSIONS (global)
// ─────────────────────────────────────────────

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  users       User[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  name        String  @unique
  displayName String?
  description String?
  category    String?
  riskLevel   String?

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id String @id @default(uuid())

  email       String? @unique
  phoneNumber String? @unique
  username    String? @unique

  passwordHash String

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  status UserStatus @default(ACTIVE)

  isEmailVerified Boolean @default(false)
  isPhoneVerified Boolean @default(false)

  lastLoginAt DateTime?

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  profile Profile?

  sessions      Session[]
  refreshTokens RefreshToken[]

  uploadedFiles File[]

  groupMemberships GroupMember[]
  sentInvites      GroupInvite[] @relation("InviteSender")
  receivedInvites  GroupInvite[] @relation("InviteRecipient")

  createdGroups  Group[] @relation("GroupCreator")
  approvedGroups Group[] @relation("GroupApprover")

  // Social features
  following Follow[] @relation("UserFollowing")
  followers Follow[] @relation("UserFollowers")

  posts   Post[]
  stories Story[]
  reels   Reel[]

  postLikes    PostLike[]
  reelLikes    ReelLike[]
  commentLikes CommentLike[]

  comments     Comment[]
  reelComments ReelComment[]

  savedPosts     SavedPost[]
  storyViews     StoryView[]
  storyReactions StoryReaction[]
  storyComments  StoryComment[]

  // Phase 3 Messaging Relations
  conversationMembers ConversationMember[]
  messages            Message[]
  messageReactions    MessageReaction[]
  messageReads        MessageRead[]
  messageDeliveries   MessageDelivery[]
  pinnedMessages      PinnedMessage[]
  starredMessages     StarredMessage[]
  groupJoinRequests   GroupJoinRequest[]
  presence            UserPresence?
  notifications       Notification[]
  auditLogs           AuditLog[]

  // Phase 4 Video Platform Relations
  uploadedVideos     Video[]             @relation("VideoUploader")
  videoComments      VideoComment[]      @relation("UserVideoComments")
  videoLikes         VideoLike[]         @relation("UserVideoLikes")
  videoCommentLikes  VideoCommentLike[]  @relation("UserVideoCommentLikes")
  videoBookmarks     VideoBookmark[]     @relation("UserVideoBookmarks")
  videoSubscriptions VideoSubscription[] @relation("UserVideoSubscriptions")
  videoWatchHistory  VideoWatchHistory[] @relation("UserWatchHistory")
  videoReports       VideoReport[]       @relation("VideoReporter")
  videoPlaylists     VideoPlaylist[]     @relation("PlaylistOwner")
  downloadRecords    DownloadRecord[]    @relation("UserDownloads")
  publishedDownloads DownloadRecord[]    @relation("PublisherDownloads")

  // Phase 5 Live Streaming Relations
  createdStreams             LiveStream[]         @relation("StreamCreator")
  streamViewerSessions       StreamViewer[]       @relation("StreamViewers")
  streamChatMessages         StreamChatMessage[]  @relation("StreamChatSender")
  streamChatReactions        StreamChatReaction[] @relation("StreamChatReactions")
  streamReactions            StreamReaction[]     @relation("StreamReactions")
  streamBookmarks            StreamBookmark[]     @relation("StreamBookmarks")
  streamReports              StreamReport[]       @relation("StreamReporters")
  streamModerators           StreamModerator[]    @relation("StreamModerators")
  streamModeratorAssignments StreamModerator[]    @relation("StreamModeratorAssigner")
  streamPolls                StreamPoll[]         @relation("StreamPolls")
  streamPollVotes            StreamPollVote[]     @relation("StreamPollVotes")
  streamHighlights           StreamHighlight[]    @relation("StreamHighlights")

  // Advanced Messaging Relations
  conversationBlocks    ConversationBlock[] @relation("ConversationBlocker")
  blockedByUsers        ConversationBlock[] @relation("ConversationBlocked")
  forwardedMessages     MessageForward[]    @relation("ForwardOriginalSender")
  messageMentions       MessageMention[]    @relation("MessageMentionUser")

  // Channels & Groups Separation Relations
  ownedChannels         VideoChannel[]         @relation("ChannelOwner")
  reviewedChannels      VideoChannel[]         @relation("ChannelReviewer")
  channelModerations    ChannelModerator[]     @relation("ChannelModerators")
  channelCommunityPosts ChannelCommunityPost[] @relation("ChannelPostAuthor")
  channelPostLikes      ChannelPostLike[]      @relation("ChannelPostLiker")
  channelPostComments   ChannelPostComment[]   @relation("ChannelCommentAuthor")
  createdTopics         GroupTopic[]           @relation("TopicCreator")
  createdGroupPolls     GroupPoll[]            @relation("GroupPollCreator")
  groupPollVotes        GroupPollVote[]        @relation("GroupPollVoter")
  groupAuditLogs        GroupAuditLog[]        @relation("GroupAuditActor")

  // Phase 6/7 Relations
  searchHistory SearchHistory[] @relation("UserSearchHistory")
  reports       Report[]        @relation("UserReports")
  deviceTokens  DeviceToken[]   @relation("UserDeviceTokens")

  // Ethiopian Calendar
  calendarNotes CalendarNote[] @relation("UserCalendarNotes")
  calendarEvents CalendarEvent[] @relation("UserCreatedCalendarEvents")

  // Login Policy Management
  modifiedLoginPolicies LoginPolicy[]          @relation("LoginPolicyModifier")
  loginPolicyAuditLogs  LoginPolicyAuditLog[]  @relation("LoginPolicyAuditActor")

  // Phase 8 — Digital Library
  createdCategories   BookCategory[]       @relation("CategoryCreator")
  createdBooks        Book[]               @relation("BookCreator")
  updatedBooks        Book[]               @relation("BookUpdater")
  bookProgress        UserBookProgress[]
  bookBookmarks       UserBookmark[]
  bookAnnotations     UserBookAnnotation[]
  readingPrefs        UserReadingPrefs?
  modifiedBookDownloadSettings BookDownloadSetting[] @relation("BookDownloadSettingModifier")

  // Dictionary Relations
  createdLanguages    DictionaryLanguage[]     @relation("LanguageCreator")
  translationHistories UserTranslationHistory[]

  // Amharic Alephat Learning & Reference
  createdAlephatLetters   AlephatLetter[]  @relation("AlephatLetterCreator")
  updatedAlephatLetters   AlephatLetter[]  @relation("AlephatLetterUpdater")
  createdAlephat22Entries Alephat22Entry[] @relation("Alephat22Creator")
  updatedAlephat22Entries Alephat22Entry[] @relation("Alephat22Updater")


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  @@index([email])
  @@index([phoneNumber])
  @@index([username])
  @@index([roleId])
  @@map("users")
}

// ─────────────────────────────────────────────
// PROFILE
// ─────────────────────────────────────────────

model Profile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName   String?
  lastName    String?
  displayName String?
  bio         String?   @db.Text
  website     String?
  country     String?
  language    String?
  gender      Gender?
  birthDate   DateTime?

  visibility ProfileVisibility @default(PUBLIC)

  /// Publisher download permission preference default
  allowDownloadsByDefault Boolean @default(true)

  isVerified        Boolean   @default(false)
  verifiedAt        DateTime?
  verificationBadge String?

  avatarFileId String?
  coverFileId  String?

  avatar File? @relation("ProfileAvatar", fields: [avatarFileId], references: [id])
  cover  File? @relation("ProfileCover", fields: [coverFileId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("profiles")
}

// ─────────────────────────────────────────────
// GROUP
// ─────────────────────────────────────────────

model Group {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String? @db.Text
  avatarUrl   String?
  coverUrl    String?
  website     String?
  country     String?

  status     GroupStatus     @default(PENDING_APPROVAL)
  visibility GroupVisibility @default(PUBLIC)

  /// The user who created the group
  createdById String
  createdBy   User   @relation("GroupCreator", fields: [createdById], references: [id])

  /// Admin who approved or rejected the group (ADMIN/SUPER_ADMIN)
  approvedById String?
  approvedBy   User?     @relation("GroupApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  members GroupMember[]
  invites GroupInvite[]
  files   File[]
  posts   Post[]

  // Phase 3 Messaging Relations
  channels      Channel[]
  conversations Conversation[]
  joinRequests  GroupJoinRequest[]

  // Phase 4 Video Platform Relations
  videoChannels VideoChannel[] @relation("GroupVideoChannels")

  // Phase 5 Live Streaming Relations
  liveStreams LiveStream[] @relation("GroupLiveStreams")

  // Telegram-style Advanced Group Features
  slowModeSeconds    Int               @default(0)
  isForum            Boolean           @default(false)
  defaultPermissions Json?
  topics             GroupTopic[]
  polls              GroupPoll[]
  auditLogs          GroupAuditLog[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([slug])
  @@index([status])
  @@index([createdById])
  @@map("groups")
}

model GroupMember {
  id      String @id @default(uuid())
  groupId String
  userId  String

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  role GroupRole @default(MEMBER)

  customTitle String?
  permissions Json?
  isMuted     Boolean   @default(false)
  mutedUntil  DateTime?

  joinedAt  DateTime  @default(now())
  removedAt DateTime?

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@map("group_members")
}

model GroupInvite {
  id      String @id @default(uuid())
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("InviteSender", fields: [senderId], references: [id])

  recipientId String
  recipient   User   @relation("InviteRecipient", fields: [recipientId], references: [id])

  role   GroupRole    @default(MEMBER)
  status InviteStatus @default(PENDING)
  token  String       @unique @default(uuid())

  expiresAt   DateTime
  respondedAt DateTime?

  createdAt DateTime @default(now())

  @@index([groupId])
  @@index([recipientId])
  @@index([token])
  @@map("group_invites")
}

// ─────────────────────────────────────────────
// SESSION
// ─────────────────────────────────────────────

model Session {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ipAddress String?
  userAgent String?
  device    String?
  browser   String?
  os        String?
  location  String?

  status     SessionStatus @default(ACTIVE)
  expiresAt  DateTime
  lastSeenAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

// ─────────────────────────────────────────────
// REFRESH TOKEN
// ─────────────────────────────────────────────

model RefreshToken {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String

  expiresAt DateTime
  revokedAt DateTime?

  createdByIp String?
  userAgent   String?
  device      String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────
// FILE
// ─────────────────────────────────────────────

model File {
  id String @id @default(uuid())

  /// Original filename from the client
  originalName String

  /// Stored filename (UUID-based, safe for filesystem)
  fileName String

  mimeType  String
  extension String
  size      BigInt

  fileType FileType @default(OTHER)

  /// Storage backend used for this file
  provider   FileProvider
  /// Provider-specific key/path (e.g. "uploads/2024/01/file.jpg" for local, Cloudinary public_id, etc.)
  storageKey String
  /// Public-facing URL
  url        String

  /// SHA-256 checksum of the file contents
  checksum String?

  status FileStatus @default(READY)

  /// Width in pixels (images/video)
  width    Int?
  /// Height in pixels (images/video)
  height   Int?
  /// Duration in seconds (video/audio)
  duration Float?

  /// Thumbnail URL (for video/image, generated by provider)
  thumbnailUrl String?

  /// Additional metadata as JSON (e.g. EXIF, codec info)
  metadata Json?

  /// The user who uploaded the file
  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  /// Group is optional (group-scoped uploads or standalone uploads such as stories/profiles)
  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  /// Profiles using this file as avatar
  avatarOf Profile[] @relation("ProfileAvatar")
  /// Profiles using this file as cover
  coverOf  Profile[] @relation("ProfileCover")

  /// Post media references
  postMedia PostMedia[]

  /// Reel file references
  reels Reel[]

  /// Story file references
  stories Story[]

  /// Phase 3 Message attachment references
  messageAttachments MessageAttachment[]
  voiceMessages      VoiceMessage[]

  /// Phase 4 Video Platform references
  videoChannelAvatars VideoChannel[]   @relation("VideoChannelAvatar")
  videoChannelBanners VideoChannel[]   @relation("VideoChannelBanner")
  videoSources        Video[]          @relation("VideoSourceFile")
  videoThumbnails     Video[]          @relation("VideoThumbnail")
  downloadRecords     DownloadRecord[] @relation("FileDownloads")

  /// Phase 5 Live Streaming references
  streamThumbnails     LiveStream[]      @relation("StreamThumbnail")
  streamRecordings     StreamRecording[] @relation("StreamRecordingFile")
  streamHighlightFiles StreamHighlight[] @relation("StreamHighlightFile")

  /// Ethiopian Calendar references
  calendarNoteMedia CalendarNoteMedia[] @relation("CalendarNoteMediaFiles")

  /// Phase 8 — Digital Library book file references
  bookCovers        Book[]        @relation("BookCoverFile")
  bookContents      Book[]        @relation("BookContentFile")
  bookChapterFiles  BookChapter[] @relation("BookChapterContentFile")
  bookAttachmentFiles BookAttachment[] @relation("BookAttachmentFiles")



  /// Soft delete
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([uploadedById])
  @@index([groupId])
  @@index([fileType])
  @@index([status])
  @@index([deletedAt])
  @@map("files")
}

// ─────────────────────────────────────────────
// FOLLOW
// ─────────────────────────────────────────────

model Follow {
  followerId  String
  followingId String

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

// ─────────────────────────────────────────────
// POST
// ─────────────────────────────────────────────

model Post {
  id       String @id @default(uuid())
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  type       PostType
  status     PostStatus     @default(PUBLISHED)
  visibility PostVisibility @default(PUBLIC)

  content  String?  @db.Text
  hashtags String[]
  mentions String[] // array of user IDs mentioned

  /// Denormalized counters for feed performance
  likesCount    Int @default(0)
  commentsCount Int @default(0)
  sharesCount   Int @default(0)
  viewsCount    Int @default(0)
  downloadsCount Int @default(0)

  /// Publisher download permissions
  allowDownloads     Boolean            @default(true)
  downloadPermission DownloadPermission @default(PUBLIC)

  media           PostMedia[]
  likes           PostLike[]
  comments        Comment[]
  savedBy         SavedPost[]
  downloadRecords DownloadRecord[]

  // Calendar Note association (if automatically or manually generated from calendar)
  calendarNoteId  String?
  calendarNote    CalendarNote? @relation("CalendarNotePosts", fields: [calendarNoteId], references: [id], onDelete: SetNull)
  calendarPublicationOccurrences CalendarPublicationOccurrence[]

  publishedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([authorId])
  @@index([groupId])
  @@index([status, visibility, publishedAt(sort: Desc)])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([calendarNoteId])
  @@map("posts")
}

model PostMedia {
  id      String  @id @default(uuid())
  postId  String
  fileId  String
  order   Int     @default(0)
  caption String?
  altText String?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  file File @relation(fields: [fileId], references: [id])

  @@index([postId])
  @@map("post_media")
}

// ─────────────────────────────────────────────
// LIKES
// ─────────────────────────────────────────────

model PostLike {
  userId   String
  postId   String
  reaction ReactionType @default(LIKE)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, postId])
  @@index([postId])
  @@map("post_likes")
}

model ReelLike {
  userId   String
  reelId   String
  reaction ReactionType @default(LIKE)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reel Reel @relation(fields: [reelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, reelId])
  @@index([reelId])
  @@map("reel_likes")
}

model CommentLike {
  userId    String
  commentId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, commentId])
  @@index([commentId])
  @@map("comment_likes")
}

// ─────────────────────────────────────────────
// COMMENTS
// ─────────────────────────────────────────────

model Comment {
  id       String @id @default(uuid())
  postId   String
  authorId String

  /// null = root-level comment; non-null = reply to another comment
  parentId String?

  content    String @db.Text
  likesCount Int    @default(0)

  post    Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  Comment?      @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[]     @relation("CommentReplies")
  likes   CommentLike[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([postId])
  @@index([parentId])
  @@index([authorId])
  @@index([deletedAt])
  @@map("comments")
}

model ReelComment {
  id         String  @id @default(uuid())
  reelId     String
  authorId   String
  parentId   String?
  content    String  @db.Text
  likesCount Int     @default(0)

  reel    Reel          @relation(fields: [reelId], references: [id], onDelete: Cascade)
  author  User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  ReelComment?  @relation("ReelCommentReplies", fields: [parentId], references: [id])
  replies ReelComment[] @relation("ReelCommentReplies")

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([reelId])
  @@index([authorId])
  @@map("reel_comments")
}

// ─────────────────────────────────────────────
// STORIES
// ─────────────────────────────────────────────

model Story {
  id       String @id @default(uuid())
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  type StoryType

  fileId String?
  file   File?   @relation(fields: [fileId], references: [id])

  content         String? @db.Text
  backgroundColor String?
  textColor       String?

  viewsCount     Int @default(0)
  reactionsCount Int @default(0)
  commentsCount  Int @default(0)

  expiresAt DateTime // set to createdAt + 24h at creation

  views     StoryView[]
  reactions StoryReaction[]
  comments  StoryComment[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@index([authorId, expiresAt])
  @@index([authorId])
  @@index([expiresAt])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("stories")
}

model StoryView {
  storyId  String
  viewerId String

  story  Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer User  @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  viewedAt DateTime @default(now())

  @@id([storyId, viewerId])
  @@index([storyId])
  @@index([viewerId])
  @@index([viewedAt(sort: Desc)])
  @@map("story_views")
}

model StoryReaction {
  storyId  String
  userId   String
  reaction ReactionType @default(LIKE)

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([storyId, userId])
  @@index([storyId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("story_reactions")
}

model StoryComment {
  id       String @id @default(uuid())
  storyId  String
  authorId String
  content  String @db.Text

  story  Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([storyId])
  @@index([authorId])
  @@index([createdAt(sort: Desc)])
  @@map("story_comments")
}

// ─────────────────────────────────────────────
// REELS
// ─────────────────────────────────────────────

model Reel {
  id       String @id @default(uuid())
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  fileId String
  file   File   @relation(fields: [fileId], references: [id])

  thumbnailUrl String?
  caption      String?  @db.Text
  hashtags     String[]
  mentions     String[]

  duration Float // in seconds

  likesCount     Int @default(0)
  commentsCount  Int @default(0)
  viewsCount     Int @default(0)
  sharesCount    Int @default(0)
  downloadsCount Int @default(0)

  /// Publisher download permissions
  allowDownloads Boolean @default(true)

  visibility PostVisibility @default(PUBLIC)
  status     PostStatus     @default(PUBLISHED)

  likes    ReelLike[]
  comments ReelComment[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([authorId])
  @@index([status, visibility])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("reels")
}

// ─────────────────────────────────────────────
// SAVED POSTS
// ─────────────────────────────────────────────

model SavedPost {
  userId  String
  postId  String
  savedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([userId])
  @@map("saved_posts")
}

// ─────────────────────────────────────────────
// PHASE 3 MESSAGING MODELS
// ─────────────────────────────────────────────

model Channel {
  id          String      @id @default(uuid())
  groupId     String
  group       Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  type        ChannelType @default(TEXT)
  description String?     @db.Text
  isPrivate   Boolean     @default(false)

  conversations Conversation[]
  messages      Message[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([groupId, slug])
  @@index([groupId])
  @@map("channels")
}

model Conversation {
  id   String           @id @default(uuid())
  type ConversationType @default(DIRECT)

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  channelId String?  @unique
  channel   Channel? @relation(fields: [channelId], references: [id], onDelete: Cascade)

  lastMessageId String?
  lastMessageAt DateTime?

  members        ConversationMember[]
  messages       Message[]
  pinnedMessages PinnedMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
  @@index([type])
  @@index([lastMessageAt(sort: Desc)])
  @@map("conversations")
}

model ConversationMember {
  id             String @id @default(uuid())
  conversationId String
  userId         String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastReadMessageId String?
  unreadCount       Int     @default(0)
  isMuted           Boolean @default(false)
  isPinned          Boolean @default(false)

  encryptionKeyHash String? // E2EE key exchange metadata ready

  joinedAt DateTime @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
  @@index([userId, unreadCount])
  @@index([userId, isPinned])
  @@map("conversation_members")
}

model Message {
  id             String  @id @default(uuid())
  conversationId String
  channelId      String?
  senderId       String
  clientId       String?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  channel      Channel?     @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  content String?     @db.Text
  type    MessageType @default(TEXT)

  /// Threaded reply parent message
  replyToId String?
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")

  isEdited             Boolean   @default(false)
  isPinned             Boolean   @default(false)
  deletedForEveryoneAt DateTime?

  attachments MessageAttachment[]
  reactions   MessageReaction[]
  reads       MessageRead[]
  deliveries  MessageDelivery[]
  starredBy   StarredMessage[]
  pinnedIn    PinnedMessage[]
  voiceNote   VoiceMessage?
  forward     MessageForward?
  mentions    MessageMention[]

  topicId     String?
  topic       GroupTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)
  poll        GroupPoll?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId])
  @@index([channelId])
  @@index([topicId])
  @@index([senderId])
  @@index([createdAt])
  @@index([conversationId, createdAt(sort: Desc)])
  @@index([conversationId, deletedForEveryoneAt])
  @@index([replyToId])
  @@index([clientId])
  @@index([senderId, clientId])
  @@map("messages")
}

model MessageAttachment {
  id        String @id @default(uuid())
  messageId String
  fileId    String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file    File    @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([fileId])
  @@map("message_attachments")
}

model MessageReaction {
  id        String @id @default(uuid())
  messageId String
  userId    String
  emoji     String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

model MessageRead {
  messageId String
  userId    String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  readAt DateTime @default(now())

  @@id([messageId, userId])
  @@index([messageId])
  @@map("message_reads")
}

model MessageDelivery {
  messageId String
  userId    String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  deliveredAt DateTime @default(now())

  @@id([messageId, userId])
  @@index([messageId])
  @@map("message_deliveries")
}

model PinnedMessage {
  id             String @id @default(uuid())
  conversationId String
  messageId      String
  pinnedById     String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedBy     User         @relation(fields: [pinnedById], references: [id])

  createdAt DateTime @default(now())

  @@unique([conversationId, messageId])
  @@index([conversationId])
  @@map("pinned_messages")
}

model StarredMessage {
  userId    String
  messageId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  starredAt DateTime @default(now())

  @@id([userId, messageId])
  @@index([userId])
  @@map("starred_messages")
}

model VoiceMessage {
  id        String @id @default(uuid())
  messageId String @unique
  fileId    String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file    File    @relation(fields: [fileId], references: [id], onDelete: Cascade)

  duration Int // duration in seconds
  waveform Json? // waveform JSON array

  @@map("voice_messages")
}

model GroupJoinRequest {
  id      String            @id @default(uuid())
  groupId String
  userId  String
  status  JoinRequestStatus @default(PENDING)
  note    String?

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@index([groupId])
  @@index([userId])
  @@map("group_join_requests")
}

model UserPresence {
  id           String         @id @default(uuid())
  userId       String         @unique
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       PresenceStatus @default(OFFLINE)
  customStatus String?
  lastSeenAt   DateTime       @default(now())

  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("user_presence")
}

model Notification {
  id     String           @id @default(uuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType
  title  String
  body   String           @db.Text
  data   Json?
  isRead Boolean          @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model AuditLog {
  id         String  @id @default(uuid())

  /// Admin or system actor who performed the action (userId = actorId)
  userId     String?
  user       User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Machine-readable action name: USER_BANNED, GROUP_SUSPENDED, ROLE_ASSIGNED, etc.
  action     String

  /// Legacy field — kept for backward compat; new code uses targetType
  resource   String

  /// Type of entity affected: USER | GROUP | CHANNEL | POST | VIDEO | STREAM | MESSAGE | ROLE | SYSTEM
  targetType String?

  /// ID of the affected entity
  targetId   String?

  /// JSON snapshot of entity state BEFORE the action
  before     Json?

  /// JSON snapshot of entity state AFTER the action
  after      Json?

  /// Admin-provided reason (required for destructive actions)
  reason     String? @db.Text

  /// Extra context: IP, user-agent, etc.
  details    Json?
  metadata   Json?
  ipAddress  String?

  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// PHASE 4 VIDEO PLATFORM ENUMS
// ─────────────────────────────────────────────

/// Video processing lifecycle state
enum VideoStatus {
  UPLOADING
  QUEUED
  PROCESSING
  READY
  FAILED
  DELETED
}

/// Video visibility control
enum VideoVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
  GROUP_ONLY
  SCHEDULED
}

/// Supported transcoding resolutions
enum VideoResolution {
  R_240P
  R_360P
  R_480P
  R_720P
  R_1080P
  R_4K
}

/// Who can download this media
enum DownloadPermission {
  PUBLIC
  MEMBERS_ONLY
  SUBSCRIBERS_ONLY
  NONE
}

/// Playlist visibility
enum PlaylistVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

/// Video channel status
enum VideoChannelStatus {
  PENDING
  APPROVED
  ACTIVE
  REJECTED
  SUSPENDED
  ARCHIVED
  DISABLED
}

/// Video report reasons
enum VideoReportReason {
  SPAM
  VIOLENCE
  SEXUAL_CONTENT
  HATE_SPEECH
  MISINFORMATION
  COPYRIGHT
  HARASSMENT
  OTHER
}

/// Download record status
enum DownloadStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

// ─────────────────────────────────────────────
// PHASE 4: VIDEO CHANNELS
// Every video channel belongs to an approved Group.
// Users upload videos ONLY inside video channels.
// ─────────────────────────────────────────────

model VideoChannel {
  id      String  @id @default(uuid())
  groupId String?
  group   Group?  @relation("GroupVideoChannels", fields: [groupId], references: [id], onDelete: Cascade)

  ownerId String?
  owner   User?   @relation("ChannelOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  reviewedById    String?
  reviewedBy      User?     @relation("ChannelReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  rejectionReason String?
  reviewNotes     String?

  name        String
  slug        String
  handle      String  @unique // @handle for discovery
  description String? @db.Text

  avatarFileId String?
  bannerFileId String?
  avatarFile   File?   @relation("VideoChannelAvatar", fields: [avatarFileId], references: [id])
  bannerFile   File?   @relation("VideoChannelBanner", fields: [bannerFileId], references: [id])

  status     VideoChannelStatus @default(PENDING)
  visibility GroupVisibility    @default(PUBLIC)
  isVerified Boolean            @default(false)

  /// Who can upload to this channel (beyond GROUP_ADMIN/MODERATOR)
  uploadPermission GroupRole @default(MEMBER)

  /// Download permission default for videos in this channel
  downloadPermission DownloadPermission @default(MEMBERS_ONLY)

  /// Denormalized counters
  subscribersCount Int    @default(0)
  videosCount      Int    @default(0)
  totalViewsCount  BigInt @default(0)

  categories String[]
  tags       String[]
  country    String?
  language   String?
  website    String?

  /// Social links stored as JSON
  socialLinks Json?

  videos        Video[]
  subscriptions VideoSubscription[]
  playlists     VideoPlaylist[]

  // Phase 5 Live Streaming Relations
  streamKey   StreamKey?
  liveStreams LiveStream[] @relation("ChannelLiveStreams")

  // Community posts & moderators
  communityPosts ChannelCommunityPost[]
  moderators     ChannelModerator[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([groupId])
  @@index([ownerId])
  @@index([slug])
  @@index([handle])
  @@index([status])
  @@index([deletedAt])
  @@map("video_channels")
}

// ─────────────────────────────────────────────
// PHASE 4: VIDEOS
// ─────────────────────────────────────────────

model Video {
  id             String       @id @default(uuid())
  videoChannelId String
  videoChannel   VideoChannel @relation(fields: [videoChannelId], references: [id], onDelete: Cascade)

  /// The uploader (must be an authorized group member)
  uploadedById String
  uploadedBy   User   @relation("VideoUploader", fields: [uploadedById], references: [id])

  /// Original raw upload file reference
  sourceFileId String?
  sourceFile   File?   @relation("VideoSourceFile", fields: [sourceFileId], references: [id])

  title       String
  description String? @db.Text
  slug        String  @unique

  status     VideoStatus     @default(UPLOADING)
  visibility VideoVisibility @default(PRIVATE)

  /// Duration in seconds (extracted after processing)
  duration Float?

  /// Original dimensions
  width  Int?
  height Int?

  /// Bitrate in kbps
  bitrate Int?

  /// Codec info
  videoCodec String?
  audioCodec String?

  /// Thumbnail references
  thumbnailUrl    String?
  thumbnailFileId String?
  thumbnailFile   File?   @relation("VideoThumbnail", fields: [thumbnailFileId], references: [id])

  /// Preview/GIF clip URL
  previewUrl String?

  /// HLS master playlist URL (after processing)
  hlsUrl  String?
  /// DASH manifest URL (future)
  dashUrl String?

  /// Categories, tags, hashtags, mentions
  categories String[]
  tags       String[]
  hashtags   String[]
  mentions   String[] // array of user IDs

  /// SEO fields
  seoTitle       String?
  seoDescription String?

  /// Download settings
  downloadPermission DownloadPermission @default(MEMBERS_ONLY)
  isDownloadable     Boolean            @default(false)

  /// Scheduling
  scheduledAt DateTime?
  publishedAt DateTime?

  /// Engagement counters (denormalized for performance)
  viewsCount     BigInt @default(0)
  likesCount     Int    @default(0)
  dislikesCount  Int    @default(0)
  commentsCount  Int    @default(0)
  sharesCount    Int    @default(0)
  bookmarksCount Int    @default(0)
  downloadsCount Int    @default(0)

  /// Processing job ID (BullMQ)
  processingJobId String?

  /// Checksum of source file
  checksum String?

  renditions      VideoRendition[]
  chapters        VideoChapter[]
  subtitles       VideoSubtitle[]
  likes           VideoLike[]
  comments        VideoComment[]
  bookmarks       VideoBookmark[]
  reports         VideoReport[]
  watchHistory    VideoWatchHistory[]
  downloadRecords DownloadRecord[]
  playlistItems   VideoPlaylistItem[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([videoChannelId])
  @@index([uploadedById])
  @@index([status, visibility, publishedAt(sort: Desc)])
  @@index([slug])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("videos")
}

// ─────────────────────────────────────────────
// VIDEO RENDITIONS (Transcoded quality variants)
// ─────────────────────────────────────────────

model VideoRendition {
  id      String @id @default(uuid())
  videoId String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  resolution VideoResolution
  height     Int
  width      Int
  bitrate    Int
  fileSize   BigInt

  /// Storage key for the HLS .m3u8 playlist or MP4 file
  storageKey String
  url        String

  /// Provider used for this rendition
  provider FileProvider

  isReady Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([videoId, resolution])
  @@index([videoId])
  @@map("video_renditions")
}

// ─────────────────────────────────────────────
// VIDEO CHAPTERS
// ─────────────────────────────────────────────

model VideoChapter {
  id      String @id @default(uuid())
  videoId String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  title       String
  startTimeMs Int // start time in milliseconds
  order       Int

  @@index([videoId])
  @@map("video_chapters")
}

// ─────────────────────────────────────────────
// VIDEO SUBTITLES / CAPTIONS
// ─────────────────────────────────────────────

model VideoSubtitle {
  id      String @id @default(uuid())
  videoId String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  language        String // BCP 47 language tag e.g. "en", "fr"
  label           String // Human-readable label e.g. "English"
  fileUrl         String // URL to .vtt or .srt file
  storageKey      String
  provider        FileProvider
  isDefault       Boolean      @default(false)
  isAutoGenerated Boolean      @default(false)

  createdAt DateTime @default(now())

  @@unique([videoId, language])
  @@index([videoId])
  @@map("video_subtitles")
}

// ─────────────────────────────────────────────
// VIDEO PLAYLISTS
// ─────────────────────────────────────────────

model VideoPlaylist {
  id             String        @id @default(uuid())
  videoChannelId String?
  videoChannel   VideoChannel? @relation(fields: [videoChannelId], references: [id], onDelete: SetNull)

  /// Owner user
  ownerId String
  owner   User   @relation("PlaylistOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  title        String
  description  String? @db.Text
  thumbnailUrl String?

  visibility PlaylistVisibility @default(PUBLIC)

  /// Watch later / favorites are system playlists
  isSystemPlaylist Boolean @default(false)
  systemType       String? // "WATCH_LATER", "LIKED_VIDEOS", etc.

  videosCount Int @default(0)

  items VideoPlaylistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([videoChannelId])
  @@map("video_playlists")
}

model VideoPlaylistItem {
  id         String   @id @default(uuid())
  playlistId String
  videoId    String
  order      Int      @default(0)
  addedAt    DateTime @default(now())

  playlist VideoPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  video    Video         @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([playlistId, videoId])
  @@index([playlistId])
  @@map("video_playlist_items")
}

// ─────────────────────────────────────────────
// VIDEO WATCH HISTORY
// ─────────────────────────────────────────────

model VideoWatchHistory {
  id      String @id @default(uuid())
  userId  String
  videoId String

  user  User  @relation("UserWatchHistory", fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  /// Progress position in seconds
  watchedSeconds Float   @default(0)
  /// Percentage of video watched (0-100)
  watchedPercent Float   @default(0)
  /// Whether user completed the video (≥90%)
  isCompleted    Boolean @default(false)

  watchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, videoId])
  @@index([userId])
  @@index([videoId])
  @@index([watchedAt])
  @@map("video_watch_history")
}

// ─────────────────────────────────────────────
// VIDEO LIKES
// ─────────────────────────────────────────────

model VideoLike {
  userId  String
  videoId String
  isLike  Boolean // true = like, false = dislike

  user  User  @relation("UserVideoLikes", fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, videoId])
  @@index([videoId])
  @@map("video_likes")
}

// ─────────────────────────────────────────────
// VIDEO COMMENTS (Nested)
// ─────────────────────────────────────────────

model VideoComment {
  id      String @id @default(uuid())
  videoId String
  userId  String

  /// null = root comment; non-null = reply
  parentId String?

  content  String  @db.Text
  isPinned Boolean @default(false)
  isEdited Boolean @default(false)

  likesCount   Int @default(0)
  repliesCount Int @default(0)

  video   Video              @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user    User               @relation("UserVideoComments", fields: [userId], references: [id], onDelete: Cascade)
  parent  VideoComment?      @relation("VideoCommentReplies", fields: [parentId], references: [id])
  replies VideoComment[]     @relation("VideoCommentReplies")
  likes   VideoCommentLike[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([videoId])
  @@index([parentId])
  @@index([userId])
  @@index([deletedAt])
  @@map("video_comments")
}

model VideoCommentLike {
  userId    String
  commentId String

  user    User         @relation("UserVideoCommentLikes", fields: [userId], references: [id], onDelete: Cascade)
  comment VideoComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, commentId])
  @@index([commentId])
  @@map("video_comment_likes")
}

// ─────────────────────────────────────────────
// VIDEO SUBSCRIPTIONS
// ─────────────────────────────────────────────

model VideoSubscription {
  userId         String
  videoChannelId String

  user         User         @relation("UserVideoSubscriptions", fields: [userId], references: [id], onDelete: Cascade)
  videoChannel VideoChannel @relation(fields: [videoChannelId], references: [id], onDelete: Cascade)

  /// Notification preferences
  notifyOnUpload Boolean @default(true)
  notifyOnLive   Boolean @default(false)

  createdAt DateTime @default(now())

  @@id([userId, videoChannelId])
  @@index([userId])
  @@index([videoChannelId])
  @@map("video_subscriptions")
}

// ─────────────────────────────────────────────
// VIDEO BOOKMARKS (Watch Later / Favorites)
// ─────────────────────────────────────────────

model VideoBookmark {
  userId  String
  videoId String

  user  User  @relation("UserVideoBookmarks", fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  note      String?
  createdAt DateTime @default(now())

  @@id([userId, videoId])
  @@index([userId])
  @@map("video_bookmarks")
}

// ─────────────────────────────────────────────
// VIDEO REPORTS (Moderation)
// ─────────────────────────────────────────────

model VideoReport {
  id      String @id @default(uuid())
  videoId String
  userId  String

  reason  VideoReportReason
  details String?           @db.Text

  isResolved   Boolean   @default(false)
  resolvedAt   DateTime?
  resolvedById String?

  video    Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  reporter User  @relation("VideoReporter", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([videoId, userId])
  @@index([videoId])
  @@index([isResolved])
  @@map("video_reports")
}

// ─────────────────────────────────────────────
// DOWNLOAD RECORDS (Audit + Analytics)
// ─────────────────────────────────────────────

model DownloadRecord {
  id      String  @id @default(uuid())
  userId  String
  videoId String?

  /// Generic file download (for non-video files)
  fileId String?

  /// Post media download
  postId String?

  /// Original publisher identity
  publisherId String?

  resolution VideoResolution?
  status     DownloadStatus   @default(PENDING)

  /// Signed URL used for this download
  signedUrl String?
  expiresAt DateTime?

  ipAddress String?
  userAgent String?

  fileSize    BigInt?
  bytesServed BigInt? @default(0)

  /// TikTok-style Attribution & Watermark metadata
  isWatermarked   Boolean @default(false)
  watermarkText   String?
  attributionJson Json?

  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user      User   @relation("UserDownloads", fields: [userId], references: [id], onDelete: Cascade)
  publisher User?  @relation("PublisherDownloads", fields: [publisherId], references: [id], onDelete: SetNull)
  video     Video? @relation(fields: [videoId], references: [id], onDelete: SetNull)
  file      File?  @relation("FileDownloads", fields: [fileId], references: [id], onDelete: SetNull)
  post      Post?  @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([publisherId])
  @@index([videoId])
  @@index([fileId])
  @@index([postId])
  @@index([status])
  @@index([createdAt])
  @@map("download_records")
}

// ─────────────────────────────────────────────
// PHASE 5 LIVE STREAMING ENUMS
// ─────────────────────────────────────────────

enum LiveStreamStatus {
  DRAFT
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
  FAILED
}

enum LiveStreamVisibility {
  PUBLIC
  PRIVATE
  GROUP_ONLY
  UNLISTED
}

enum StreamProtocol {
  RTMP
  WEBRTC
  HLS_PULL
}

enum StreamRecordingStatus {
  RECORDING
  PROCESSING
  READY
  FAILED
  DELETED
}

enum StreamChatMessageType {
  TEXT
  EMOTE
  SUPER_CHAT
  ANNOUNCEMENT
  SYSTEM
  MODERATION
}

enum StreamModeratorRole {
  CO_HOST
  MOD
}

enum StreamPollStatus {
  DRAFT
  ACTIVE
  ENDED
}

enum StreamReportReason {
  SPAM
  VIOLENCE
  SEXUAL_CONTENT
  HATE_SPEECH
  MISINFORMATION
  COPYRIGHT
  HARASSMENT
  OTHER
}

// ─────────────────────────────────────────────
// PHASE 5: STREAM KEY
// ─────────────────────────────────────────────

model StreamKey {
  id             String       @id @default(uuid())
  videoChannelId String       @unique
  videoChannel   VideoChannel @relation(fields: [videoChannelId], references: [id], onDelete: Cascade)

  keyHash   String @unique
  keyPrefix String

  isActive   Boolean   @default(true)
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([videoChannelId])
  @@index([keyHash])
  @@map("stream_keys")
}

// ─────────────────────────────────────────────
// PHASE 5: LIVE STREAM
// ─────────────────────────────────────────────

model LiveStream {
  id             String       @id @default(uuid())
  videoChannelId String
  videoChannel   VideoChannel @relation("ChannelLiveStreams", fields: [videoChannelId], references: [id], onDelete: Cascade)

  groupId String?
  group   Group?  @relation("GroupLiveStreams", fields: [groupId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("StreamCreator", fields: [createdById], references: [id])

  title       String
  description String? @db.Text
  slug        String  @unique

  status     LiveStreamStatus     @default(DRAFT)
  visibility LiveStreamVisibility @default(PUBLIC)

  protocol StreamProtocol @default(RTMP)

  hlsUrl        String?
  dashUrl       String?
  webrtcUrl     String?
  rtmpIngestUrl String?

  thumbnailFileId String?
  thumbnailFile   File?   @relation("StreamThumbnail", fields: [thumbnailFileId], references: [id])
  thumbnailUrl    String?

  categories String[]
  tags       String[]
  hashtags   String[]

  scheduledAt     DateTime?
  startedAt       DateTime?
  endedAt         DateTime?
  /// Set once by StreamReminderService when the "still live after 2 min"
  /// notification is dispatched. NULL = not yet notified. Non-null = already
  /// notified. Guards against duplicate dispatches across dyno restarts.
  notifiedLiveAt  DateTime?

  isRecordingEnabled Boolean @default(true)
  isDvrEnabled       Boolean @default(true)
  isReplayEnabled    Boolean @default(true)

  isChatEnabled         Boolean @default(true)
  isChatSlowMode        Boolean @default(false)
  chatSlowModeSeconds   Int     @default(0)
  isMembersOnlyChat     Boolean @default(false)
  isSubscribersOnlyChat Boolean @default(false)

  peakViewerCount    Int @default(0)
  totalViewerCount   Int @default(0)
  currentViewerCount Int @default(0)
  totalChatMessages  Int @default(0)
  totalReactions     Int @default(0)
  likesCount         Int @default(0)

  duration        Float?
  vodVideoId      String? @unique
  processingJobId String?

  sessions   StreamSession[]
  chatRoom   StreamChatRoom?
  analytics  StreamAnalytics?
  recordings StreamRecording[]
  moderators StreamModerator[]
  reactions  StreamReaction[]
  reports    StreamReport[]
  bookmarks  StreamBookmark[]
  polls      StreamPoll[]
  highlights StreamHighlight[]
  viewers    StreamViewer[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([videoChannelId])
  @@index([groupId])
  @@index([createdById])
  @@index([status])
  @@index([status, startedAt])
  @@index([visibility])
  @@index([scheduledAt])
  @@index([slug])
  @@index([deletedAt])
  @@map("live_streams")
}

// ─────────────────────────────────────────────
// PHASE 5: STREAM SESSION
// ─────────────────────────────────────────────

model StreamSession {
  id           String     @id @default(uuid())
  liveStreamId String
  liveStream   LiveStream @relation(fields: [liveStreamId], references: [id], onDelete: Cascade)

  startedAt DateTime  @default(now())
  endedAt   DateTime?

  streamKeyId      String?
  ingestBitrate    Int?
  ingestResolution String?
  ingestFramerate  Int?

  peakViewers  Int @default(0)
  totalViewers Int @default(0)

  createdAt DateTime @default(now())

  @@index([liveStreamId])
  @@map("stream_sessions")
}

// ─────────────────────────────────────────────
// PHASE 5: STREAM VIEWER
// ─────────────────────────────────────────────

model StreamViewer {
  id           String @id @default(uuid())
  liveStreamId String
  userId       String

  liveStream LiveStream @relation(fields: [liveStreamId], references: [id], onDelete: Cascade)
  user       User       @relation("StreamViewers", fields: [userId], references: [id], onDelete: Cascade)

  joinedAt      DateTime  @default(now())
  leftAt        DateTime?
  watchDuration Float     @default(0)
  quality       String?

  @@index([liveStreamId])
  @@index([userId])
  @@index([joinedAt])
  @@map("stream_viewers")
}

// ─────────────────────────────────────────────
// PHASE 5: STREAM ANALYTICS
// ─────────────────────────────────────────────

model StreamAnalytics {
  id           String     @id @default(uuid())
  liveStreamId String     @unique
  liveStream   LiveStream @relation(fields: [liveStreamId], references: [id], onDelete: Cascade)

  totalUniqueViewers    Int   @default(0)
  peakConcurrentViewers Int   @default(0)
  averageWatchDuration  Float @default(0)

  totalChatMessages Int @default(0)
  totalReactions    Int @default(0)
  totalLikes        Int @default(0)
  totalShares       Int @default(0)
  totalClips        Int @default(0)

  retentionData    Json?
  geoBreakdown     Json?
  deviceBreakdown  Json?
  qualityBreakdown Json?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("stream_analytics")
}

// ─────────────────────────────────────────────
// PHASE 5: STREAM RECORDING
// ─────────────────────────────────────────────

model StreamRecording {
  id           String     @id @default(uuid())
  liveStreamId String
  liveStream   LiveStream @relation(fields: [liveStreamId], references: [id], onDelete: Cascade)

  status StreamRecordingStatus @default(RECORDING)

  fileId String?
  file   File?   @relation("StreamRecordingFile", fields: [fileId], references: [id])

  url             String?
  duration        Float?
  fileSize        BigInt?
  hlsUrl          String?
  processingJobId String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([liveStreamId])
  @@index([status])
  @@map("stream_recordings")
}

// ─────────────────────────────────────────────
// PHASE 5: STREAM CHAT ROOM
// ─────────────────────────────────────────────

model StreamChatRoom {
  id           String     @id @default(uuid())
  liveStreamId String     @unique
  liveStream   LiveStream @relation(fields: [liveStreamId], references: [id], onDelete: Cascade)

  isEnabled Boolean @default(true)

  messages StreamChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("stream_chat_rooms")
}

// ─────────────────────────────────────────────
// PHASE 5: STREAM CHAT MESSAGE
// ─────────────────────────────────────────────

model StreamChatMessage {
  id         String         @id @default(uuid())
  chatRoomId String
  chatRoom   StreamChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)

  senderId String
  sender   User   @relation("StreamChatSender", fields: [senderId], references: [id], onDelete: Cascade)

  content String                @db.Text
  type    StreamChatMessageType @default(TEXT)

  replyToId String?
  replyTo   StreamChatMessage?  @relation("ChatMessageReplies", fields: [replyToId], references: [id])
  replies   StreamChatMessage[] @relation("ChatMessageReplies")

  isPinned Boolean   @default(false)
  pinnedAt DateTime?

  superChatAmount   Int?
  superChatCurrency String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())

  reactions StreamChatReaction[]

  @@index([chatRoomId])
  @@index([senderId])
  @@index([createdAt])
  @@index([isPinned])
  @@index([deletedAt])
  @@map("stream_chat_messages")
}

// ─────────────────────────────────────────────
// PHASE 5: STREAM CHAT REACTION
// ─────────────────────────────────────────────

model StreamChatReaction {
  id        String @id @default(uuid())
  messageId String
  userId    String
  emoji     String

  message StreamChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User              @relation("StreamChatReactions", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("stream_chat_reactions")
}

// ─────────────────────────────────────────────
// PHASE 5: STREAM MODERATOR
// ─────────────────────────────────────────────

model StreamModerator {
  id           String @id @default(uuid())
  liveStreamId String
  userId       String
  assignedById String

  liveStream LiveStream @relation(fields: [liveStreamId], references: [id], onDelete: Cascade)
  user       User       @relation("StreamModerators", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User       @relation("StreamModeratorAssigner", fields: [assignedById], references: [id])

  role StreamModeratorRole @default(MOD)

  createdAt DateTime @default(now())

  @@unique([liveStreamId, userId])
  @@index([liveStreamId])
  @@map("stream_moderators")
}

// ─────────────────────────────────────────────
// PHASE 5: STREAM REACTION (floating reactions)
// ─────────────────────────────────────────────

model StreamReaction {
  id           String @id @default(uuid())
  liveStreamId String
  userId       String
  emoji        String

  liveStream LiveStream @relation(fields: [liveStreamId], references: [id], onDelete: Cascade)
  user       User       @relation("StreamReactions", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([liveStreamId])
  @@index([createdAt])
  @@map("stream_reactions")
}

// ─────────────────────────────────────────────
// PHASE 5: STREAM BOOKMARK
// ─────────────────────────────────────────────

model StreamBookmark {
  userId       String
  liveStreamId String

  user       User       @relation("StreamBookmarks", fields: [userId], references: [id], onDelete: Cascade)
  liveStream LiveStream @relation(fields: [liveStreamId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, liveStreamId])
  @@index([userId])
  @@index([liveStreamId])
  @@map("stream_bookmarks")
}

// ─────────────────────────────────────────────
// PHASE 5: STREAM REPORT
// ─────────────────────────────────────────────

model StreamReport {
  id           String @id @default(uuid())
  liveStreamId String
  reporterId   String

  liveStream LiveStream @relation(fields: [liveStreamId], references: [id], onDelete: Cascade)
  reporter   User       @relation("StreamReporters", fields: [reporterId], references: [id], onDelete: Cascade)

  reason  StreamReportReason
  details String?            @db.Text

  isResolved   Boolean   @default(false)
  resolvedAt   DateTime?
  resolvedById String?

  createdAt DateTime @default(now())

  @@unique([liveStreamId, reporterId])
  @@index([liveStreamId])
  @@index([isResolved])
  @@map("stream_reports")
}

// ─────────────────────────────────────────────
// PHASE 5: STREAM POLL
// ─────────────────────────────────────────────

model StreamPoll {
  id           String @id @default(uuid())
  liveStreamId String
  createdById  String

  liveStream LiveStream @relation(fields: [liveStreamId], references: [id], onDelete: Cascade)
  createdBy  User       @relation("StreamPolls", fields: [createdById], references: [id])

  question String
  status   StreamPollStatus @default(ACTIVE)
  endsAt   DateTime?

  options StreamPollOption[]
  votes   StreamPollVote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([liveStreamId])
  @@index([status])
  @@map("stream_polls")
}

model StreamPollOption {
  id     String     @id @default(uuid())
  pollId String
  poll   StreamPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  text       String
  voteCount  Int    @default(0)
  orderIndex Int    @default(0)

  votes StreamPollVote[]

  @@index([pollId])
  @@map("stream_poll_options")
}

model StreamPollVote {
  pollId   String
  optionId String
  userId   String

  poll   StreamPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option StreamPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User             @relation("StreamPollVotes", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([pollId, userId])
  @@index([pollId])
  @@index([optionId])
  @@map("stream_poll_votes")
}

// ─────────────────────────────────────────────
// PHASE 5: STREAM HIGHLIGHT
// ─────────────────────────────────────────────

model StreamHighlight {
  id           String @id @default(uuid())
  liveStreamId String
  createdById  String

  liveStream LiveStream @relation(fields: [liveStreamId], references: [id], onDelete: Cascade)
  createdBy  User       @relation("StreamHighlights", fields: [createdById], references: [id])

  title       String
  description String?

  startTimeSec Float
  endTimeSec   Float

  clipUrl String?
  fileId  String?
  file    File?   @relation("StreamHighlightFile", fields: [fileId], references: [id])

  isPublic Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([liveStreamId])
  @@index([createdById])
  @@map("stream_highlights")
}

// ─────────────────────────────────────────────
// PHASE 6: DISCOVERY (Search, Recommendations, Trending)
// ─────────────────────────────────────────────




model RecommendationEvent {
  id         String   @id @default(uuid())
  userId     String
  entityType String // "POST", "VIDEO", "REEL", "STREAM"
  entityId   String
  eventType  String // "VIEW", "LIKE", "COMMENT", "SHARE", "SAVE"
  value      Float    @default(1.0) // Weight of the interaction
  timestamp  DateTime @default(now())

  @@index([userId, entityType])
  @@index([timestamp])
  @@map("recommendation_events")
}

model TrendingScore {
  id         String   @id @default(uuid())
  entityType String // "POST", "VIDEO", "REEL", "STREAM", "HASHTAG"
  entityId   String
  score      Float
  window     String // "HOURLY", "DAILY", "WEEKLY"
  updatedAt  DateTime @updatedAt

  @@unique([entityType, entityId, window])
  @@index([score(sort: Desc)])
  @@map("trending_scores")
}

// ─────────────────────────────────────────────
// PHASE 7: ENTERPRISE ADMIN PLATFORM
// ─────────────────────────────────────────────



enum ModerationStatus {
  OPEN
  REVIEWING
  RESOLVED
  REJECTED
  ESCALATED
}

model ModerationCase {
  id         String @id @default(uuid())
  entityType String
  entityId   String

  status   ModerationStatus @default(OPEN)
  priority Int              @default(0) // Higher = more urgent

  assignedToId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actions ModerationAction[]

  @@unique([entityType, entityId])
  @@index([status])
  @@index([assignedToId])
  @@map("moderation_cases")
}

model ModerationAction {
  id     String         @id @default(uuid())
  caseId String
  case   ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  actorId String
  action  String // "HIDE", "DELETE", "SUSPEND", "WARN", "IGNORE"
  reason  String? @db.Text

  createdAt DateTime @default(now())

  @@index([caseId])
  @@map("moderation_actions")
}

model AnalyticsEvent {
  id         String  @id @default(uuid())
  eventType  String // "USER_SIGNUP", "VIDEO_VIEW", "POST_CREATE", "AD_CLICK"
  userId     String?
  entityType String?
  entityId   String?
  metadata   Json?

  timestamp DateTime @default(now())

  @@index([eventType, timestamp])
  @@map("analytics_events")
}

model AnalyticsAggregate {
  id        String   @id @default(uuid())
  metric    String // "DAU", "MAU", "TOTAL_VIEWS", "TOTAL_STREAMS"
  value     Float
  dimension String? // e.g., "COUNTRY:US", "DEVICE:MOBILE"
  window    String // "HOURLY", "DAILY", "WEEKLY", "MONTHLY"
  timestamp DateTime

  @@unique([metric, dimension, window, timestamp])
  @@map("analytics_aggregates")
}

// ─────────────────────────────────────────────
// EXTENSIONS TO EXISTING MODELS FOR PHASE 6/7
// ─────────────────────────────────────────────
// We also need to add relation names back to User. We can just run a Prisma migration for these models.
// NOTE: I will manually add the relation for User->Report and User->SearchHistory in the User model later if needed, 
// but Prisma allows omitting the back-relation on User if not strictly required, though it's best practice.

// ─────────────────────────────────────────────
// MOBILE PUSH — DEVICE TOKENS
// ─────────────────────────────────────────────

model DeviceToken {
  id        String @id @default(uuid())
  userId    String
  token     String @unique // FCM registration token
  platform  String // "ANDROID" | "IOS" | "WEB"
  deviceId  String? // Optional device fingerprint

  user User @relation("UserDeviceTokens", fields: [userId], references: [id], onDelete: Cascade)

  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("device_tokens")
}

// ─────────────────────────────────────────────
// MESSAGING ENHANCEMENTS — Advanced Messaging
// ─────────────────────────────────────────────

/// Tracks blocked users within conversations context
model ConversationBlock {
  id             String @id @default(uuid())
  blockerId      String
  blockedUserId  String

  blocker     User @relation("ConversationBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedUser User @relation("ConversationBlocked", fields: [blockedUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blockerId, blockedUserId])
  @@index([blockerId])
  @@index([blockedUserId])
  @@map("conversation_blocks")
}

/// Forward metadata — tracks which message was forwarded from
model MessageForward {
  id                  String @id @default(uuid())
  messageId           String @unique
  originalMessageId   String
  originalSenderId    String
  originalConversationId String

  message             Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  originalSender      User    @relation("ForwardOriginalSender", fields: [originalSenderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([messageId])
  @@index([originalMessageId])
  @@map("message_forwards")
}

/// Inline @mention inside a message
model MessageMention {
  id           String @id @default(uuid())
  messageId    String
  mentionedUserId String

  message      Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mentionedUser User   @relation("MessageMentionUser", fields: [mentionedUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([messageId, mentionedUserId])
  @@index([messageId])
  @@index([mentionedUserId])
  @@map("message_mentions")
}

// ─────────────────────────────────────────────
// SEARCH HISTORY & REPORTS
// ─────────────────────────────────────────────

model SearchHistory {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation("UserSearchHistory", fields: [userId], references: [id], onDelete: Cascade)
  query      String
  filters    Json?
  entityType String?
  timestamp  DateTime? @default(now())
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("search_history")
}

model Report {
  id           String           @id @default(uuid())
  reporterId   String
  reporter     User             @relation("UserReports", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType   ReportTargetType @default(USER)
  targetId     String
  targetUserId String?
  reason       ReportReason     @default(OTHER)
  comment      String?          @db.Text
  status       ReportStatus     @default(PENDING)
  actionTaken  String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([reporterId])
  @@index([targetId])
  @@index([targetType])
  @@index([status])
  @@map("reports")
}

// ─────────────────────────────────────────────
// ETHIOPIAN CALENDAR NOTES
// ─────────────────────────────────────────────

model CalendarNote {
  id    String @id @default(uuid())
  
  // Owner
  userId String
  user   User   @relation("UserCalendarNotes", fields: [userId], references: [id], onDelete: Cascade)
  
  // Ethiopian date (primary)
  ethiopianYear  Int
  ethiopianMonth Int // 1-13 (Pagumen is 13)
  ethiopianDay   Int
  
  // Gregorian date (for queries and sorting)
  gregorianDate DateTime
  
  // Content
  title   String?
  content String? @db.Text
  allowDownload Boolean @default(false)

  
  // Reminders
  hasReminder       Boolean   @default(false)
  reminderDateTime  DateTime?
  reminderNotified  Boolean   @default(false)
  reminderRepeat    CalendarReminderRepeat @default(NONE)
  reminderEthiopianMonth Int?
  reminderEthiopianDay   Int?
  reminderHour      Int?
  reminderMinute    Int?
  reminderTimezone  String @default("Africa/Addis_Ababa")
  reminderNextOccurrence DateTime?

  // Recurrence & Automated Publication
  recurrenceType        CalendarReminderRepeat @default(NONE)
  isAutoPublishEnabled  Boolean                @default(false)
  autoPublishTime       String?                @default("12:00")
  
  // Media attachments
  media CalendarNoteMedia[]

  // Publication occurrences & generated posts
  publicationOccurrences CalendarPublicationOccurrence[]
  posts                  Post[]                  @relation("CalendarNotePosts")
  
  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  
  @@index([userId])
  @@index([ethiopianYear, ethiopianMonth])
  @@index([gregorianDate])
  @@index([deletedAt])
  @@index([userId, hasReminder, reminderNextOccurrence])
  @@map("calendar_notes")
}

model CalendarNoteMedia {
  id String @id @default(uuid())
  
  // Note reference
  noteId String
  note   CalendarNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  
  // File reference (reuse existing File model)
  fileId String
  file   File   @relation("CalendarNoteMediaFiles", fields: [fileId], references: [id], onDelete: Cascade)
  
  // Display order and optional caption
  order   Int
  caption String?
  
  createdAt DateTime @default(now())
  
  @@index([noteId])
  @@index([fileId])
  @@map("calendar_note_media")
}

model CalendarPublicationOccurrence {
  id                    String                    @id @default(uuid())
  calendarNoteId        String
  calendarNote          CalendarNote              @relation(fields: [calendarNoteId], references: [id], onDelete: Cascade)
  recurrenceType        CalendarReminderRepeat
  occurrenceEthiopianDate String                  // e.g. "2019-03-09"
  occurrenceYear        Int
  occurrenceMonth       Int
  occurrenceDay         Int
  scheduledAt           DateTime
  publishedAt           DateTime?
  generatedPostId       String?
  generatedPost         Post?                     @relation(fields: [generatedPostId], references: [id], onDelete: SetNull)
  publicationStatus     CalendarPublicationStatus @default(PENDING)
  lastError             String?
  retryCount            Int                       @default(0)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@unique([calendarNoteId, recurrenceType, occurrenceEthiopianDate], name: "calendar_note_recurrence_occurrence_unique")
  @@index([publicationStatus, scheduledAt])
  @@index([occurrenceEthiopianDate])
  @@index([generatedPostId])
  @@map("calendar_publication_occurrences")
}

model CalendarSyncMetadata {
  id                  String   @id @default(uuid())
  userId              String?
  activeWindowStart   String
  activeWindowEnd     String
  lastSuccessfulSyncAt DateTime @default(now())
  lastSyncCursor      String?
  schemaVersion       Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
  @@map("calendar_sync_metadata")
}

// ─────────────────────────────────────────────
// ETHIOPIAN CALENDAR FASTS & HOLIDAYS
// ─────────────────────────────────────────────

model CalendarEvent {
  id               String                @id @default(uuid())
  name             String
  nameEn           String?
  type             CalendarEventType
  category         CalendarEventCategory @default(MAJOR_HOLIDAY)

  // Recurring vs year-specific
  isRecurring      Boolean               @default(true)
  ethiopianYear    Int?                  // Null for annual recurring; set for movable fasts/feasts (e.g. 2017)

  // Ethiopian start date
  startMonth       Int                   // 1-13
  startDay         Int                   // 1-30
  startYear        Int?

  // Ethiopian end date
  endMonth         Int                   // 1-13
  endDay           Int                   // 1-30
  endYear          Int?

  // Content & details
  description      String?               @db.Text
  spiritualMeaning String?               @db.Text
  fastingRules     String?               @db.Text

  // Visuals & Styling
  primaryColor     String?
  icon             String?
  isMajor          Boolean               @default(false)
  importance       String?               @default("NORMAL")
  isActive         Boolean               @default(true)

  // Audit
  createdById      String?
  createdBy        User?                 @relation("UserCreatedCalendarEvents", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  deletedAt        DateTime?

  @@index([type, isActive])
  @@index([startMonth, endMonth])
  @@index([ethiopianYear, isActive])
  @@index([deletedAt])
  @@map("calendar_events")
}

// ─────────────────────────────────────────────
// AMHARIC ALEPHAT LEARNING & REFERENCE
// ─────────────────────────────────────────────

model AlephatLetter {
  id                 String   @id @default(uuid())
  letter             String   @unique // e.g. "ሀ"
  name               String?  // e.g. "ሆይ", "አልፋ"
  order              Int      @default(0)
  defaultNote        String?  @db.Text
  pronunciationGuide String?
  mediaUrls          String[] @default([])
  isPublished        Boolean  @default(true)

  createdById        String?
  updatedById        String?
  createdBy          User?    @relation("AlephatLetterCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy          User?    @relation("AlephatLetterUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  familyMembers      AlephatFamilyMember[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([order])
  @@index([isPublished])
  @@index([createdById])
  @@map("alephat_letters")
}

model AlephatFamilyMember {
  id            String         @id @default(uuid())
  baseLetterId  String
  baseLetter    AlephatLetter  @relation(fields: [baseLetterId], references: [id], onDelete: Cascade)
  glyph         String         // e.g. "ሀ", "ሁ", "ሂ", "ሃ", "ሄ", "ህ", "ሆ", "ሇ"
  orderIndex    Int            // 1=ግዕዝ, 2=ካዕብ, 3=ሣልስ, 4=ራብዕ, 5=ኃምስ, 6=ሳድስ, 7=ሳብዕ, 8=ሳምን
  orderName     String?        // e.g. "ግዕዝ", "ካዕብ", "ሣልስ", "ራብዕ", "ኃምስ", "ሳድስ", "ሳብዕ", "ሳምን"
  note          String?        @db.Text
  pronunciation String?
  mediaUrls     String[]       @default([])
  isPublished   Boolean        @default(true)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([baseLetterId, orderIndex])
  @@index([baseLetterId])
  @@index([orderIndex])
  @@map("alephat_family_members")
}

model Alephat22Entry {
  id                String   @id @default(uuid())
  letter            String   // e.g. "አ"
  title             String   // e.g. "አሌፍ (አ)"
  meaning           String?  // e.g. "አምላክ / መጀመሪያ"
  order             Int      @default(0) // 1 to 22
  note              String   @db.Text
  supplementaryInfo String?  @db.Text
  isPublished       Boolean  @default(true)

  createdById       String?
  updatedById       String?
  createdBy         User?    @relation("Alephat22Creator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy         User?    @relation("Alephat22Updater", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([order])
  @@index([isPublished])
  @@index([createdById])
  @@map("alephat_22_entries")
}


// ─────────────────────────────────────────────
// LOGIN POLICY MANAGEMENT (Admin Controlled)
// ─────────────────────────────────────────────

/// Singleton table — exactly ONE active login policy for the platform.
/// Controlled exclusively by SUPER_ADMIN / users with auth.login-policy.manage permission.
model LoginPolicy {
  id String @id @default(uuid())

  /// Which policy type is currently active
  activePolicy LoginPolicyType @default(SINGLE_IDENTIFIER)

  /// Whether users can also provide any single identifier (used in SINGLE_IDENTIFIER mode)
  allowEmail    Boolean @default(true)
  allowPhone    Boolean @default(true)
  allowUsername Boolean @default(true)

  /// For DUAL_IDENTIFIER: which combination is required
  dualCombination DualIdentifierCombination?

  /// Whether any policy updates are currently locked (emergency override)
  isLocked Boolean @default(false)

  /// Informational note for admins
  description String? @db.Text

  /// The admin who last modified this policy
  lastModifiedById String?
  lastModifiedBy   User?   @relation("LoginPolicyModifier", fields: [lastModifiedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("login_policies")
}

/// Immutable audit trail of every login policy change.
model LoginPolicyAuditLog {
  id String @id @default(uuid())

  /// Admin who made the change
  actorId String?
  actor   User?   @relation("LoginPolicyAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  /// Snapshot of settings before the change
  before Json?

  /// Snapshot of settings after the change
  after Json?

  /// Human-readable reason provided by the admin
  reason String? @db.Text

  /// Extra context: IP, user-agent, etc.
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
  @@map("login_policy_audit_logs")
}

// ─────────────────────────────────────────────
// PHASE 8: DIGITAL LIBRARY (BOOKS)
// ─────────────────────────────────────────────

enum BookStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  DELETED
}

enum BookFormat {
  PDF
  EPUB
  TEXT
  AUDIO
  EXTERNAL_LINK
}

enum BookLanguage {
  AMHARIC
  GEEZ
  ENGLISH
  OTHER
}

enum DictionaryProcessingStatus {
  PENDING
  VALIDATING
  EXTRACTING
  PARSING
  INDEXING
  READY
  FAILED
  RETRYING
}

// Hierarchical category tree for the library.
// parentId = null → top-level category/tab.
model BookCategory {
  id          String  @id @default(uuid())
  name        String
  nameAm      String?
  nameGez     String?
  description String? @db.Text
  slug        String  @unique

  parentId String?
  parent   BookCategory?  @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children BookCategory[] @relation("CategoryChildren")

  sortOrder  Int     @default(0)
  isVisible  Boolean @default(true)
  isArchived Boolean @default(false)

  iconName String?
  coverUrl String?

  books Book[]

  createdById String?
  createdBy   User?   @relation("CategoryCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([parentId])
  @@index([sortOrder])
  @@index([isVisible])
  @@index([deletedAt])
  @@map("book_categories")
}

model Book {
  id String @id @default(uuid())

  title       String
  titleAm     String?
  titleGez    String?
  subtitle    String?
  author      String?
  translator  String?
  description String? @db.Text

  categoryId String?
  category   BookCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  language BookLanguage @default(AMHARIC)
  format   BookFormat   @default(PDF)

  publisher     String?
  publishedYear Int?
  edition       String?
  isbn          String?
  pageCount     Int?

  tags String[]

  status BookStatus @default(DRAFT)

  coverFileId String?
  coverFile   File?   @relation("BookCoverFile", fields: [coverFileId], references: [id], onDelete: SetNull)

  contentFileId String?
  contentFile   File?   @relation("BookContentFile", fields: [contentFileId], references: [id], onDelete: SetNull)

  externalUrl String?
  sortOrder   Int     @default(0)

  viewsCount     Int @default(0)
  bookmarksCount Int @default(0)

  progress    UserBookProgress[]
  bookmarks   UserBookmark[]
  annotations UserBookAnnotation[]
  chapters    BookChapter[]
  attachments BookAttachment[]

  // Dictionary Fields
  isDictionary             Boolean                  @default(false)
  dictionaryConfig         DictionaryBookConfig?
  dictionaryEntries        DictionaryEntry[]
  userTranslationHistories UserTranslationHistory[]


  deletedAt DateTime?

  createdById String?
  createdBy   User?   @relation("BookCreator", fields: [createdById], references: [id], onDelete: SetNull)

  updatedById String?
  updatedBy   User?   @relation("BookUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([language])
  @@index([format])
  @@index([sortOrder])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([isDictionary])
  @@map("books")
}

// Ordered chapters for TEXT/AUDIO/EPUB-style structured books.
// For PDF books, chapters are navigated by page number only.
model BookChapter {
  id     String @id @default(uuid())
  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  order       Int
  title       String
  titleAm     String?
  titleGez    String?

  // Inline content for TEXT format books
  content     String? @db.Text

  // Per-chapter file (e.g. separate audio file per chapter, or PDF page range)
  contentFileId String?
  contentFile   File?   @relation("BookChapterContentFile", fields: [contentFileId], references: [id], onDelete: SetNull)

  // Duration in seconds for AUDIO chapters
  durationSeconds Int?

  isPublished Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookId, order])
  @@index([bookId])
  @@index([bookId, order])
  @@map("book_chapters")
}

model UserBookProgress {

  id     String @id @default(uuid())
  userId String
  bookId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  currentPage     Int?
  currentChapter  Int?
  scrollOffset    Float?
  percentComplete Float   @default(0)
  isCompleted     Boolean @default(false)

  lastReadAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, bookId])
  @@index([userId])
  @@index([bookId])
  @@index([lastReadAt])
  @@map("user_book_progress")
}

model UserBookmark {
  id     String @id @default(uuid())
  userId String
  bookId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  page    Int?
  chapter Int?
  label   String?
  note    String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([bookId])
  @@index([userId, bookId])
  @@map("user_book_bookmarks")
}

model UserBookAnnotation {
  id     String @id @default(uuid())
  userId String
  bookId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  page           Int?
  chapter        Int?
  startOffset    Int?
  endOffset      Int?
  selectedText   String? @db.Text
  note           String? @db.Text
  highlightColor String?
  annotationType String  @default("highlight")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([bookId])
  @@index([userId, bookId])
  @@index([deletedAt])
  @@map("user_book_annotations")
}

model UserReadingPrefs {
  id     String @id @default(uuid())
  userId String @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  fontSize    Float  @default(16)
  lineSpacing Float  @default(1.5)
  fontFamily  String @default("default")
  textAlign   String @default("left")

  themeMode  String @default("system")
  pageMargin Float  @default(16)
  scrollMode String @default("paginated")

  gridView          Boolean @default(true)
  sortBy            String  @default("title")
  sortAsc           Boolean @default(true)
  defaultCategoryId String?

  defaultHighlightColor String @default("#FFEB3B")

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("user_reading_prefs")
}

// ─────────────────────────────────────────────
// BOOK DOWNLOAD DESTINATION & MULTI-MEDIA ATTACHMENTS
// ─────────────────────────────────────────────

enum BookDownloadDestination {
  IN_APP
  DEVICE_FILE_MANAGER
  BOTH
}

/// Admin-controlled persistent download destination setting for books.
model BookDownloadSetting {
  id          String                  @id @default(uuid())
  destination BookDownloadDestination @default(IN_APP)
  description String?                 @db.Text

  updatedById String?
  updatedBy   User?                   @relation("BookDownloadSettingModifier", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@map("book_download_settings")
}

/// Multi-media attachments associated with a book (audio, video, documents, images)
model BookAttachment {
  id        String   @id @default(uuid())
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  fileId    String
  file      File     @relation("BookAttachmentFiles", fields: [fileId], references: [id], onDelete: Cascade)

  title     String?
  sortOrder Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookId])
  @@index([fileId])
  @@map("book_attachments")
}

// ─────────────────────────────────────────────
// DICTIONARY SYSTEM (BOOK-AWARE MULTILINGUAL)
// ─────────────────────────────────────────────

model DictionaryLanguage {
  id             String    @id @default(uuid())
  code           String    @unique
  name           String
  nativeName     String
  direction      String    @default("ltr")
  localizedNames Json?
  isEnabled      Boolean   @default(true)
  sortOrder      Int       @default(0)

  sourceDictionaries DictionaryBookConfig[] @relation("SourceLanguage")
  targetDictionaries DictionaryBookConfig[] @relation("TargetLanguage")

  createdById    String?
  createdBy      User?     @relation("LanguageCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([code])
  @@index([isEnabled])
  @@index([sortOrder])
  @@index([deletedAt])
  @@map("dictionary_languages")
}

model DictionaryBookConfig {
  id               String                     @id @default(uuid())
  bookId           String                     @unique
  book             Book                       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  dictionaryName   String
  description      String?                    @db.Text
  sourceLanguageId String
  sourceLanguage   DictionaryLanguage         @relation("SourceLanguage", fields: [sourceLanguageId], references: [id])
  targetLanguageId String
  targetLanguage   DictionaryLanguage         @relation("TargetLanguage", fields: [targetLanguageId], references: [id])
  processingStatus DictionaryProcessingStatus @default(PENDING)
  totalEntries     Int                        @default(0)
  errorMessage     String?                    @db.Text
  processedAt      DateTime?
  metadata         Json?

  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  entries          DictionaryEntry[]

  @@index([bookId])
  @@index([sourceLanguageId])
  @@index([targetLanguageId])
  @@index([processingStatus])
  @@map("dictionary_book_configs")
}

model DictionaryEntry {
  id                 String                @id @default(uuid())
  bookId             String
  book               Book                  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  configId           String
  config             DictionaryBookConfig  @relation(fields: [configId], references: [id], onDelete: Cascade)

  headword           String
  normalizedHeadword String

  sourceLanguageCode String
  targetLanguageCode String

  definition         String                @db.Text
  definitions        Json?

  entryNumber        Int                   @default(0)
  pageNumber         Int?
  chapterTitle       String?
  metadata           Json?

  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  historyItems       UserTranslationHistory[]

  @@index([bookId])
  @@index([configId])
  @@index([normalizedHeadword])
  @@index([sourceLanguageCode, targetLanguageCode])
  @@index([sourceLanguageCode, normalizedHeadword])
  @@map("dictionary_entries")
}

model UserTranslationHistory {
  id                     String           @id @default(uuid())
  userId                 String
  user                   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  word                   String
  sourceLanguage         String
  targetLanguage         String
  definition             String           @db.Text

  dictionaryBookId       String?
  dictionaryBook         Book?            @relation(fields: [dictionaryBookId], references: [id], onDelete: SetNull)

  dictionaryEntryId      String?
  dictionaryEntry        DictionaryEntry? @relation(fields: [dictionaryEntryId], references: [id], onDelete: SetNull)

  dictionaryNameSnapshot String

  pageNumber             Int?
  chapter                String?
  surroundingSentence    String?          @db.Text

  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, word])
  @@index([userId, sourceLanguage, targetLanguage])
  @@map("user_translation_histories")
}

// ─────────────────────────────────────────────
// CHANNELS (YOUTUBE-STYLE) & GROUPS (TELEGRAM-STYLE) SEPARATION
// ─────────────────────────────────────────────

model ChannelCommunityPost {
  id           String   @id @default(uuid())
  channelId    String
  channel      VideoChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId     String
  author       User     @relation("ChannelPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  title        String?
  content      String   @db.Text
  mediaUrls    String[]
  likesCount   Int      @default(0)
  commentsCount Int     @default(0)
  isPinned     Boolean  @default(false)

  likes        ChannelPostLike[]
  comments     ChannelPostComment[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([channelId])
  @@index([authorId])
  @@index([createdAt(sort: Desc)])
  @@map("channel_community_posts")
}

model ChannelPostLike {
  id        String   @id @default(uuid())
  postId    String
  post      ChannelCommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("ChannelPostLiker", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@map("channel_post_likes")
}

model ChannelPostComment {
  id        String   @id @default(uuid())
  postId    String
  post      ChannelCommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("ChannelCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  content   String   @db.Text
  parentId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([authorId])
  @@map("channel_post_comments")
}

model ChannelModerator {
  id          String   @id @default(uuid())
  channelId   String
  channel     VideoChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("ChannelModerators", fields: [userId], references: [id], onDelete: Cascade)

  role        String   @default("MODERATOR")
  permissions Json?

  createdAt   DateTime @default(now())

  @@unique([channelId, userId])
  @@map("channel_moderators")
}

model GroupTopic {
  id          String   @id @default(uuid())
  groupId     String
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  title       String
  iconEmoji   String?
  color       Int?
  isClosed    Boolean  @default(false)
  isPinned    Boolean  @default(false)

  createdById String
  createdBy   User     @relation("TopicCreator", fields: [createdById], references: [id])

  messages    Message[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([groupId])
  @@map("group_topics")
}

model GroupPoll {
  id                    String   @id @default(uuid())
  groupId               String
  group                 Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  conversationId        String?
  messageId             String?  @unique
  message               Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  question              String
  isAnonymous           Boolean  @default(false)
  allowsMultipleAnswers Boolean  @default(false)
  isClosed              Boolean  @default(false)

  createdById           String
  createdBy             User     @relation("GroupPollCreator", fields: [createdById], references: [id])

  options               GroupPollOption[]
  votes                 GroupPollVote[]

  createdAt             DateTime @default(now())

  @@index([groupId])
  @@map("group_polls")
}

model GroupPollOption {
  id         String   @id @default(uuid())
  pollId     String
  poll       GroupPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text       String
  votesCount Int      @default(0)

  votes      GroupPollVote[]

  @@index([pollId])
  @@map("group_poll_options")
}

model GroupPollVote {
  id        String   @id @default(uuid())
  pollId    String
  poll      GroupPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId  String
  option    GroupPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("GroupPollVoter", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([pollId, userId, optionId])
  @@index([pollId])
  @@index([userId])
  @@map("group_poll_votes")
}

model GroupAuditLog {
  id        String   @id @default(uuid())
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User     @relation("GroupAuditActor", fields: [actorId], references: [id])

  action    String
  targetId  String?
  details   Json?

  createdAt DateTime @default(now())

  @@index([groupId])
  @@index([actorId])
  @@index([createdAt(sort: Desc)])
  @@map("group_audit_logs")
}
